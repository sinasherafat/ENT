# Required only on the first start, when no administrator account exists.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional runtime settings.
PORT=4173
HOST=127.0.0.1
SESSION_HOURS=12

# Vercel only: created automatically when a private Blob store is connected.
# Never commit the real value.
# BLOB_READ_WRITE_TOKEN=
